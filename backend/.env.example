APP_ENV=development
APP_NAME=GeniusTrader API
APP_TIMEZONE=Asia/Shanghai
DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@127.0.0.1:5432/DATABASE_NAME
SESSION_COOKIE_NAME=geniustrader_session
CSRF_COOKIE_NAME=geniustrader_csrf
SESSION_TTL_SECONDS=604800
SESSION_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
LOG_LEVEL=INFO
APP_ENCRYPTION_KEYS=FERNET_KEY_PLACEHOLDER
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_INPUT_CHARS=30000
AI_MAX_OUTPUT_TOKENS=4000
AI_MAX_RETRIES=1
CONTENT_FETCH_TIMEOUT_SECONDS=10
CONTENT_FETCH_MAX_BYTES=2097152
CONTENT_FETCH_MAX_REDIRECTS=3
CONTENT_ALLOWED_TYPES=text/html,text/plain,application/xhtml+xml
ALLOW_PRIVATE_AI_BASE_URL=false
INFORMATION_MAX_MANUAL_TEXT_CHARS=50000

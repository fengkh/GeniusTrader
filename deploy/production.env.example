# Copy to an untracked production env file and fill values on the target server.
POSTGRES_DB=geniustrader
POSTGRES_USER=geniustrader
POSTGRES_PASSWORD=change-me-with-a-strong-secret
APP_ENCRYPTION_KEYS=base64-fernet-key-1,base64-fernet-key-2
APP_ENV=production
SESSION_COOKIE_SECURE=true
CORS_ALLOWED_ORIGINS=https://your-domain.example
TRUSTED_HOSTS=your-domain.example
NEXT_PUBLIC_API_BASE_URL=https://your-domain.example

# Data Provider defaults are intentionally off until authorization is frozen.
MARKET_DATA_SYNC_ENABLED=false
MARKET_DATA_REAL_NETWORK_ENABLED=false
MARKET_DATA_TUSHARE_ENABLED=false
MARKET_DATA_TUSHARE_AUTHORIZATION_STATUS=unverified
ANNOUNCEMENT_INGESTION_ENABLED=false
ANNOUNCEMENT_REAL_NETWORK_ENABLED=false
